ExecStart=/home/quant/dev/copytrade-paper-release-814db12/.venv/bin/copytrade-pm-paper-observed --source-db /home/quant/.local/share/copytrade/prospective/p1p14-observer-20261105/paper-events.sqlite3 --registry-db /home/quant/.local/share/copytrade/registry/wallet_registry.sqlite --portfolio %i --state-root /home/quant/.local/share/copytrade/prospective/registry-paper-%i-persistent-20261107 --run-id paper_%i_persistent_0711 --watch --poll-seconds 2
