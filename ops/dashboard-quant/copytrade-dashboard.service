[Unit]
Description=Read-only copytrade dashboard, quant user and Bubblewrap sandbox
Documentation=https://github.com/hzminhzz/copytrade-pm/issues/167
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=3
# No Requires/BindsTo/PartOf on Guardian, broker, planner or watchers.

[Service]
Type=simple
WorkingDirectory=/home/quant
EnvironmentFile=/home/quant/.config/copytrade-dashboard/private.env
ExecStart=/home/quant/.local/share/copytrade-dashboard/launch.sh
Restart=on-failure
RestartSec=5
TimeoutStartSec=40
TimeoutStopSec=10
NoNewPrivileges=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
UMask=0077
LimitNOFILE=256
TasksMax=96
CPUQuota=50%
MemoryMax=536870912
MemorySwapMax=0
# No root-level permissions or broker/Guardian dependencies.
# Explicit Bubblewrap mounts enforce filesystem isolation even under quant.

[Install]
WantedBy=default.target
