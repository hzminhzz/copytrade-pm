[Unit]
Description=Copytrade read-only Grafana (Docker Compose / Tailscale)
Documentation=https://github.com/hzminhzz/copytrade-pm/issues/180
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/quant/.local/share/copytrade-grafana/current
ExecStart=/bin/bash /home/quant/.local/share/copytrade-grafana/current/ops/grafana-phase1/production.sh start
ExecStop=/bin/bash /home/quant/.local/share/copytrade-grafana/current/ops/grafana-phase1/production.sh stop
# Exit 3 reports degraded evidence; it must not restart a running stack.
SuccessExitStatus=3
Restart=on-failure
RestartSec=10
TimeoutStartSec=300
TimeoutStopSec=120
UMask=0077
NoNewPrivileges=yes
# This user has Docker group access; container runtime is an existing host trust boundary.

[Install]
WantedBy=default.target
