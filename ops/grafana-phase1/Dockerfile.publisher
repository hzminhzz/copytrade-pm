FROM python:3.14-slim@sha256:af8a5aa14780025dbfbcfbc81bd8a91ebd87711dd5b0f48ed71090949dd7cb1d
WORKDIR /app
COPY pyproject.toml README.md /app/
COPY src /app/src/
RUN pip install --no-cache-dir 'starlette==1.10.0' 'cryptography==50.0.2' 'pydantic==2.14.3' && pip install --no-cache-dir --no-deps .
RUN useradd --uid 10002 --create-home publisher
USER publisher
CMD ["python","-m","copytrade_pm.dashboard.evidence_plane","--dir","/evidence","--interval","15","--health-source","/health-source"]
