{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "copytrade-wallet-health-research",
      "folder": "copytrade-risk-v1",
      "interval": "5m",
      "rules": [
        {
          "uid": "ct-trackb-health-evidence-fault",
          "title": "Wallet health requires operator review (research only)",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "queryType": "",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "risk-projection-v1",
              "model": {
                "refId": "A",
                "type": "json",
                "source": "url",
                "url": "http://projection:17800/v1/wallet-health",
                "parser": "backend",
                "format": "table",
                "root_selector": "monitoring",
                "columns": [
                  {
                    "selector": "health_evidence_fault",
                    "text": "fault",
                    "type": "number"
                  }
                ],
                "url_options": {
                  "method": "GET"
                },
                "filters": [],
                "computed_columns": [],
                "datasource": {
                  "type": "yesoreyeram-infinity-datasource",
                  "uid": "risk-projection-v1"
                }
              }
            },
            {
              "refId": "B",
              "queryType": "",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "classic_conditions",
                "conditions": [
                  {
                    "type": "query",
                    "query": {
                      "params": [
                        "A"
                      ]
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    },
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0.5
                      ]
                    },
                    "operator": {
                      "type": "and"
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "Alerting",
          "execErrState": "Alerting",
          "for": "0s",
          "isPaused": false,
          "labels": {
            "severity": "warning",
            "service": "copytrade-grafana",
            "authority": "research-presentation-only"
          },
          "annotations": {
            "summary": "A published daily wallet-health assessment is stale, has material review warnings, or is missing. Operator review only: never change k, exclusions, HALT, inventory or Guardian based on this alert."
          }
        }
      ]
    }
  ]
}
