FROM python:3.14-slim
WORKDIR /app
COPY pyproject.toml README.md /app/
COPY src /app/src/
RUN pip install --no-cache-dir 'starlette>=1.6,<2' 'uvicorn>=0.52,<0.53' 'cryptography>=46' && pip install --no-cache-dir --no-deps .
RUN useradd --system --uid 10001 reader
USER reader
EXPOSE 17800
CMD ["uvicorn","copytrade_pm.dashboard.grafana_projection:app","--host","0.0.0.0","--port","17800","--no-access-log"]
