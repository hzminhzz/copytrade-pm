#!/usr/bin/env bash
# Local CI gate: blocks a push whose tree fails scripts/ci.sh.
# Deliberate bypass: SKIP_CI=1 git push
set -euo pipefail

if [[ "${SKIP_CI:-0}" == "1" ]]; then
    printf 'pre-push: local CI skipped (SKIP_CI=1)\n' >&2
    exit 0
fi

# Strip caller Git hook env vars (GIT_DIR, GIT_INDEX_FILE, etc.) so pytest's
# isolated git fixtures cannot hijack the pushing worktree or its index.
while IFS= read -r git_var; do
    [[ -n "$git_var" ]] && unset "$git_var"
done < <(git rev-parse --local-env-vars 2>/dev/null || true)
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY \
    GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_COMMON_DIR GIT_PREFIX \
    GIT_IMPLICIT_WORK_TREE GIT_GRAFT_FILE GIT_SHALLOW_FILE \
    GIT_NO_REPLACE_OBJECTS GIT_REPLACE_REF_BASE GIT_CONFIG \
    GIT_CONFIG_PARAMETERS GIT_CONFIG_COUNT GIT_NAMESPACE || true

TOPLEVEL="$(git rev-parse --show-toplevel 2>/dev/null || (cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd))"

# Repeated pushes of the SAME clean SHA can reuse its independently verified
# full-suite receipt. A changed tree, absent Python environment, missing,
# stale, or corrupt receipt always falls back to the complete CI gate.
# CI_FORCE_FULL=1 forces a fresh full run even when a valid receipt exists.
CI_PYTHON=""
for candidate in "$TOPLEVEL/.venv-ci-core/bin/python" "$TOPLEVEL/.venv/bin/python"; do
    if [[ -x "$candidate" ]]; then
        CI_PYTHON="$candidate"
        break
    fi
done
if [[ "${CI_FORCE_FULL:-0}" != "1" ]] &&
   [[ -z "$(git status --porcelain --untracked-files=normal)" ]] &&
   [[ -n "$CI_PYTHON" ]]; then
    SHA="$(git rev-parse HEAD)"
    CI_GIT_DIR="$(git rev-parse --absolute-git-dir)"
    for receipt in "$CI_GIT_DIR/local-ci/$SHA-"*.json; do
        [[ -f "$receipt" && ! -L "$receipt" ]] || continue
        if PYTHONPATH="$TOPLEVEL/src" "$CI_PYTHON" \
            -m copytrade_pm.pm_ci_receipt verify \
            --root "$TOPLEVEL" --receipt "$receipt" --sha "$SHA" >/dev/null 2>&1; then
            printf 'pre-push: verified exact-commit CI receipt sha=%s receipt=%s\n' "$SHA" "$receipt" >&2
            exit 0
        fi
    done
fi
exec "$TOPLEVEL/scripts/ci.sh" all
